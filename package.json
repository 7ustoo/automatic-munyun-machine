{
  "name": "automatic-munyun-machine",
  "version": "7.7.0",
  "description": "Local-first desktop job search: 50–200 daily matches ranked against your resume.",
  "type": "module",
  "main": "scripts/daily-batch.mjs",
  "bin": {
    "amm-setup": "./scripts/setup-wizard.mjs",
    "amm-batch": "./scripts/daily-batch.mjs"
  },
  "scripts": {
    "setup": "node scripts/setup-wizard.mjs",
    "daily": "node scripts/daily-batch.mjs",
    "bot": "node scripts/telegram-bot.mjs",
    "login": "node scripts/login-once.mjs",
    "parse-resume": "node scripts/resume-parser.mjs",
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/check-syntax.mjs",
    "build:wrapper": "cd wrapper && make build",
    "test:ui": "node dev/dashboard-harness/run-all.mjs",
    "test:e2e": "node dev/dashboard-harness/run-e2e.mjs",
    "test:gmail-live": "node dev/live-gmail-e2e.mjs"
  },
  "keywords": [
    "job-search",
    "desktop-app",
    "resume-matching",
    "telegram-bot",
    "playwright",
    "automation",
    "greenhouse",
    "lever",
    "ashby",
    "hiring-cafe",
    "career-tools"
  ],
  "author": "Justin Williams",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "mammoth": "^1.7.0",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^1.1.1",
    "playwright-core": "^1.45.0",
    "proper-lockfile": "^4.0.0"
  },
  "homepage": "https://github.com/7ustoo/automatic-munyun-machine#readme",
  "bugs": {
    "url": "https://github.com/7ustoo/automatic-munyun-machine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7ustoo/automatic-munyun-machine.git"
  }
}
