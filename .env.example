# Automatic Munyun Machine — environment variables
# Copy this file to .env and fill in the values. The setup wizard does this for you.

# Telegram bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID (auto-detected by the setup wizard from the first message
# you send to your bot)
TELEGRAM_CHAT_ID=
