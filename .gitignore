# Secrets — never commit
.env
scripts/google-oauth-client.json
.env.*
!.env.example

# User data — kept local
config.json
cv.md
cv.pdf
*.docx
data/
!data/.gitkeep

# Private context (personal info, locked policy values, live PIDs) — local only
CONTEXT-PRIVATE.md
*PRIVATE*.md

# Node
node_modules/
# Portable Node runtime bundled into the Windows installer at CI time (v4.1.1) —
# generated by the "Bundle portable Node runtime" release step, never committed.
runtime/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log

# Build / temp
dist/
build/
!scripts/build/
tmp/
*.zip
*.tar.gz
# Stray local wrapper build (real build output goes to wrapper/dist/ via `make`)
wrapper/wrapper.exe

# Local Claude Code state
.claude/

# dashboard harness runtime junk (browser profile + screenshots)
dev/dashboard-harness/app-window-test-profile/
dev/dashboard-harness/shots/
